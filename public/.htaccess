# Hostinger / LiteSpeed Production .htaccess Configuration for Premier Tours
# Prevents HTTP 422, MultiViews collisions, and ensures direct asset delivery

# Disable MultiViews to prevent LiteSpeed content-negotiation 422 errors
Options -MultiViews
Options +FollowSymLinks

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 1. Existing physical files or directories MUST be served directly by the web server
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Never rewrite missing media, images, styles, or scripts to index.html
  RewriteCond %{REQUEST_URI} \.(jpe?g|png|gif|webp|avif|svg|ico|css|js|woff2?|ttf|eot|map|json)$ [NC]
  RewriteRule ^ - [R=404,L]

  # 3. Route SPA application routes to index.html (only if not an API request)
  RewriteCond %{REQUEST_URI} !^/api/ [NC]
  RewriteRule ^ index.html [L]
</IfModule>

# Correct MIME Types for Hostinger Linux / LiteSpeed Server
<IfModule mod_mime.c>
  AddType image/jpeg .jpg .jpeg
  AddType image/png .png
  AddType image/webp .webp
  AddType image/avif .avif
  AddType image/svg+xml .svg
  AddType image/x-icon .ico
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Enable Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Browser Caching Rules for Static Assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

