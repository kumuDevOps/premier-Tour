# ==========================================
# PREMIER TOURS & TRAVELS — ENVIRONMENT CONFIGURATION
# ==========================================

# Production Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/premier_tours?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_ACCESS_SECRET=your_secure_jwt_secret_key_here

# Server Port
PORT=3000

# Client-Side Configuration (Vite)
VITE_API_URL=/api
VITE_ENABLE_DEMO_REVIEWS=false
